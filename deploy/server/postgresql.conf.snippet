# ==============================================================================
# eNote Offline LAN Server Settings (192.214.23.15)
# Append these lines to postgresql.conf (typically located in %PGDATA% or C:\Program Files\PostgreSQL\15\data\postgresql.conf)
# ==============================================================================

# Listen on all network interfaces so workstations on the 192.214.23.x subnet can connect
listen_addresses = '*'

# Standard PostgreSQL port
port = 5432

# Concurrency & connection limits for LAN clients
max_connections = 100

# Recommended memory settings for dedicated or mixed office server
shared_buffers = 512MB
work_mem = 16MB
maintenance_work_mem = 64MB

# Logging for troubleshooting connectivity
log_destination = 'stderr'
logging_collector = on
log_directory = 'log'
log_filename = 'postgresql-%Y-%m-%d_%H%M%S.log'
log_connections = on
log_disconnections = on
log_line_prefix = '%m [%p] %q%u@%d '

# Character encoding and locale
client_encoding = 'UTF8'
lc_messages = 'English_United States.1252'
lc_monetary = 'English_United States.1252'
lc_numeric = 'English_United States.1252'
lc_time = 'English_United States.1252'

